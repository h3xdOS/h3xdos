#!/usr/bin/env python3
"""Brings the Xfce settings of an account up to the H3XD defaults of the installed release.

Package updates cannot change the xfconf settings in each home directory, so every login
runs the steps this account has not had yet. A failed step is retried at the next login;
the steps are written so that running one twice does no harm. Every login also refreshes
the account's copy of the H3XD colours and toggle pictures for GTK 4."""

import hashlib
import os
import subprocess
import sys
import time
import xml.etree.ElementTree as ElementTree

SKEL = "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
HIDDEN_ENTRY = "/usr/share/h3xd/autostart-hidden.desktop"
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
LEVEL_FILE = os.path.join(STATE_HOME, "h3xd", "session-level")
AUTOSTART = os.path.join(CONFIG_HOME, "autostart")
PANEL_BUS_NAME = "org.xfce.Panel"
PANEL_WAIT_S = 20
ICON_THEME = "H3XD"
PREVIOUS_ICON_THEME = "Papirus-Dark"
SKEL_GTK3_CSS = "/etc/skel/.config/gtk-3.0/gtk.css"
GTK3_CSS = os.path.join(CONFIG_HOME, "gtk-3.0", "gtk.css")
SKEL_GTK4_CSS = "/etc/skel/.config/gtk-4.0/gtk.css"
GTK4_CSS = os.path.join(CONFIG_HOME, "gtk-4.0", "gtk.css")
# Flatpak apps see ~/.config/gtk-4.0 but not /usr/share, so the colours are copied there.
H3XD_GTK4_SOURCE = "/usr/share/h3xd/gtk-4.0/libadwaita.css"
H3XD_GTK4_COPY = os.path.join(CONFIG_HOME, "gtk-4.0", "h3xd.css")
# The toggle pictures the colours refer to, next to the copy.
H3XD_GTK4_ASSETS = "/usr/share/h3xd/gtk-4.0/h3xd-assets"
H3XD_GTK4_ASSETS_COPY = os.path.join(CONFIG_HOME, "gtk-4.0", "h3xd-assets")
STARSHIP_CONFIG = os.path.join(CONFIG_HOME, "starship.toml")
# The prompt that releases 1.0 to 1.0.3 copied into new accounts; an unchanged copy gives
# way to the system prompt in /usr/share/h3xd, which updates reach.
SHIPPED_STARSHIP_SHA256 = {"5da2b71a394cdd9ca004d26fd9a575cef9a8167481acdbf2cc801dfd9f8c53a4"}
# The shortcuts of the volume and microphone keys in the skeleton.
VOLUME_KEYS = "/commands/custom/XF86Audio"


def log(message):
    print(f"h3xd-session-update: {message}", file=sys.stderr)


def properties(node, prefix=""):
    """Yields (path, type, value) for every property of an xfconf channel file; an array
    yields its list of (type, value) pairs."""
    for prop in node.findall("property"):
        path = f"{prefix}/{prop.get('name')}"
        kind = prop.get("type")
        if kind == "array":
            yield path, kind, [(value.get("type"), value.get("value"))
                               for value in prop.findall("value")]
        elif kind != "empty":
            yield path, kind, prop.get("value")
        yield from properties(prop, path)


def xfconf(channel, *args):
    subprocess.run(["xfconf-query", "-c", channel, *args], check=True)


def apply_channel(channel, reset=()):
    """Sets every property of the skeleton file of a channel, after removing the
    property trees named in reset."""
    listed = subprocess.run(["xfconf-query", "-c", channel, "-l"], capture_output=True,
                            text=True, check=False).stdout.split()
    for path in reset:
        if any(name == path or name.startswith(path + "/") for name in listed):
            xfconf(channel, "-p", path, "-r", "-R")
    root = ElementTree.parse(os.path.join(SKEL, f"{channel}.xml")).getroot()
    for path, kind, value in properties(root):
        if kind == "array":
            args = ["-p", path, "-n", "-a"]
            for value_type, item in value:
                args += ["-t", value_type, "-s", item]
        else:
            args = ["-p", path, "-n", "-t", kind, "-s", value]
        xfconf(channel, *args)


def apply_shortcuts():
    """xfwm4 keeps one key per action, and xfce4-settings copies the default keys into
    the custom set on first use, so the keys that the skeleton gives to another action
    have to go first; keys for actions the skeleton does not touch stay."""
    channel = "xfce4-keyboard-shortcuts"
    root = ElementTree.parse(os.path.join(SKEL, f"{channel}.xml")).getroot()
    wanted = {path: value for path, _kind, value in properties(root)
              if path.startswith("/xfwm4/custom/") and not path.endswith("/override")}
    actions = set(wanted.values())
    listed = subprocess.run(["xfconf-query", "-c", channel, "-l", "-v"], capture_output=True,
                            text=True, check=True).stdout
    for line in listed.splitlines():
        path, _space, value = line.partition(" ")
        if path.startswith("/xfwm4/custom/") and path not in wanted \
                and value.strip() in actions:
            xfconf(channel, "-p", path, "-r")
    apply_channel(channel)


def wait_for_panel():
    deadline = time.monotonic() + PANEL_WAIT_S
    while time.monotonic() < deadline:
        reply = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
             "--object-path", "/org/freedesktop/DBus",
             "--method", "org.freedesktop.DBus.NameHasOwner", PANEL_BUS_NAME],
            capture_output=True, text=True, check=True).stdout
        if "true" in reply:
            return True
        time.sleep(0.5)
    return False


def hide_autostart(name, process):
    """Switches off a system autostart entry for this account and stops its process."""
    os.makedirs(AUTOSTART, exist_ok=True)
    target = os.path.join(AUTOSTART, name)
    if not os.path.exists(target):
        with open(HIDDEN_ENTRY) as source, open(target, "w") as copy:
            copy.write(source.read())
    # The full command line is matched because process names are cut to 15 characters
    # ("xfce4-screensaver" would never match). pkill exits 1 when no such process runs,
    # which is the normal case after the first login.
    pattern = f"(^|/){process}( |$)"
    result = subprocess.run(["pkill", "-u", str(os.getuid()), "-f", "--", pattern],
                            check=False)
    if result.returncode not in (0, 1):
        raise RuntimeError(f"pkill {process} exited {result.returncode}")


def step_1_0_2():
    """Floating panel with clock and Wi-Fi popups, Hyprland-style keys, five workspaces,
    the design 2c lock screen through light-locker."""
    apply_channel("xfwm4")
    apply_shortcuts()
    apply_channel("xfce4-session")
    hide_autostart("xfce4-screensaver.desktop", "xfce4-screensaver")
    hide_autostart("nm-applet.desktop", "nm-applet")
    panel_running = wait_for_panel()
    apply_channel("xfce4-panel", reset=("/panels", "/plugins"))
    # The reset removed the bar image, which depends on the screen width.
    subprocess.run(["h3xd-panel-background"], check=True)
    if panel_running:
        subprocess.run(["xfce4-panel", "-r"], check=True)


def step_1_0_2_1():
    """The H3XD icon theme in place of the former default; an icon theme the account
    picked itself stays."""
    channel, path = "xsettings", "/Net/IconThemeName"
    current = subprocess.run(["xfconf-query", "-c", channel, "-p", path], capture_output=True,
                             text=True, check=False)
    # A missing property exits non-zero and gets the theme as well.
    if current.returncode == 0 and current.stdout.strip() != PREVIOUS_ICON_THEME:
        return
    xfconf(channel, "-p", path, "-n", "-t", "string", "-s", ICON_THEME)


def step_1_0_3():
    """Tray icons in one row inside the panel bar with their menu on left click, and the
    H3XD colours for GTK 4 and libadwaita applications."""
    channel = "xfce4-panel"
    listed = subprocess.run(["xfconf-query", "-c", channel, "-l", "-v"], capture_output=True,
                            text=True, check=True).stdout
    for line in listed.splitlines():
        path, _space, value = line.partition(" ")
        if path.count("/") == 2 and path.startswith("/plugins/") and value.strip() == "systray":
            for name in ("single-row", "menu-is-primary"):
                xfconf(channel, "-p", f"{path}/{name}", "-n", "-t", "bool", "-s", "true")
    install_user_css(SKEL_GTK4_CSS, GTK4_CSS, os.path.basename(H3XD_GTK4_COPY))


def install_user_css(skeleton, target, marker):
    """Gives the account the skeleton's user stylesheet, unless it has its own; marker is
    the import that shows the H3XD rules are in it already."""
    if not os.path.exists(target):
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(skeleton) as source, open(target, "w") as copy:
            copy.write(source.read())
        return
    with open(target) as handle:
        if marker not in handle.read():
            # The account has its own styles there; adding ours could undo them.
            log(f"{target} exists without the H3XD rules; left as it is")


def step_1_0_3_1():
    """The terminal of design 2f: window settings and padding for every account, and the
    system prompt for accounts that kept the prompt file of the earlier releases unchanged."""
    apply_channel("xfce4-terminal")
    install_user_css(SKEL_GTK3_CSS, GTK3_CSS, "/usr/share/h3xd/gtk-3.0/user.css")
    if os.path.exists(STARSHIP_CONFIG):
        with open(STARSHIP_CONFIG, "rb") as handle:
            digest = hashlib.sha256(handle.read()).hexdigest()
        if digest in SHIPPED_STARSHIP_SHA256:
            os.remove(STARSHIP_CONFIG)
        else:
            log(f"{STARSHIP_CONFIG} has the account's own changes; left as it is")


def copy_if_changed(source, target):
    with open(source, "rb") as handle:
        wanted = handle.read()
    if os.path.exists(target):
        with open(target, "rb") as handle:
            if handle.read() == wanted:
                return
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "wb") as handle:
        handle.write(wanted)


def refresh_gtk4_colours():
    copy_if_changed(H3XD_GTK4_SOURCE, H3XD_GTK4_COPY)
    for name in os.listdir(H3XD_GTK4_ASSETS):
        copy_if_changed(os.path.join(H3XD_GTK4_ASSETS, name),
                        os.path.join(H3XD_GTK4_ASSETS_COPY, name))


def step_1_0_5():
    """The volume keys through H3XD Volume, which shows the level on screen. A key that
    the account has given to something else keeps it."""
    channel = "xfce4-keyboard-shortcuts"
    root = ElementTree.parse(os.path.join(SKEL, f"{channel}.xml")).getroot()
    for path, kind, value in properties(root):
        if not path.startswith(VOLUME_KEYS):
            continue
        current = subprocess.run(["xfconf-query", "-c", channel, "-p", path],
                                 capture_output=True, text=True, check=False)
        # A missing property exits non-zero.
        if current.returncode != 0:
            xfconf(channel, "-p", path, "-n", "-t", kind, "-s", value)


STEPS = [step_1_0_2, step_1_0_2_1, step_1_0_3, step_1_0_3_1, step_1_0_5]


def main():
    try:
        refresh_gtk4_colours()
    except OSError as error:
        # Only GTK 4 colours are at stake; the steps below still run.
        log(f"cannot refresh {H3XD_GTK4_COPY}: {error}")
    try:
        with open(LEVEL_FILE) as handle:
            level = int(handle.read().strip() or 0)
    except FileNotFoundError:
        level = 0
    for number, step in enumerate(STEPS, start=1):
        if number <= level:
            continue
        try:
            step()
        except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
            log(f"step {number} ({step.__name__}) failed, retrying at the next login: {error}")
            return 1
        os.makedirs(os.path.dirname(LEVEL_FILE), exist_ok=True)
        with open(LEVEL_FILE, "w") as handle:
            handle.write(f"{number}\n")
        log(f"applied step {number} ({step.__name__})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
