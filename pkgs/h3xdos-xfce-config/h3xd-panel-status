#!/usr/bin/env bash
# Text indicators for the H3XD panel (design 2a), read by xfce4-genmon-plugin:
# a muted label followed by the value; a wired connection shows the RJ45 mark and the
# interface instead. "bat" prints nothing without a battery.
set -euo pipefail

readonly muted='#8b95a5'
readonly value='#e6edf3'
readonly bar_off='#3a4253'
# The RJ45 tile of the H3XD icon theme.
readonly wired_icon='network-wired'
# Lower one eighth, three eighths, five eighths and full block.
readonly bars=(▂ ▄ ▆ █)
# Hover tone for the clickable indicators, the tile colour of sheet 2f.
readonly hover_css='button { margin: 14px 0; padding: 0 8px; border-radius: 3px; } button:hover { background-color: #1a202b; }'

# Pango markup must not see raw &, < or > from window titles or network names.
escape() {
    local text=$1
    text=${text//&/&amp;}
    text=${text//</&lt;}
    text=${text//>/&gt;}
    printf '%s' "$text"
}

# field <label> <value> <click command> <tooltip> [extra markup after the value]
# Without a <tool> tag genmon shows its own command line as the tooltip.
field() {
    printf '<txt><span foreground="%s">%s</span> <span foreground="%s">%s</span>%s</txt>' \
        "$muted" "$1" "$value" "$(escape "$2")" "${5:-}"
    printf '<tool>%s</tool><txtclick>%s</txtclick><css>%s</css>\n' \
        "$(escape "$4")" "$3" "$hover_css"
}

title() {
    local window name
    window=$(xprop -root _NET_ACTIVE_WINDOW | awk '{ print $NF }')
    if [[ $window == 0x0 ]]; then
        echo '<txt></txt><tool></tool>'
        return
    fi
    name=$(xprop -id "$window" _NET_WM_NAME | sed -n 's/^[^"]*"\(.*\)"$/\1/p')
    printf '<txt><span foreground="%s">%s</span></txt><tool>%s</tool>\n' \
        "$muted" "$(escape "$name")" "$(escape "$name")"
}

clock() {
    printf '<txt><span weight="600" foreground="%s">%s</span>  <span foreground="%s">%s</span></txt>' \
        "$value" "$(date +%H:%M)" "$muted" "$(date '+%a %-d %b')"
    printf '<tool>%s</tool><txtclick>h3xd-calendar</txtclick><css>%s</css>\n' \
        "$(date '+%A %x')" "$hover_css"
}

# Four bars, lit up to the signal strength in percent.
signal_bars() {
    local strength=$1 level n out=''
    level=$(( strength <= 0 ? 0 : (strength / 25 + 1 > 4 ? 4 : strength / 25 + 1) ))
    for n in 0 1 2 3; do
        if (( n < level )); then
            out+="<span foreground=\"$value\">${bars[n]}</span>"
        else
            out+="<span foreground=\"$bar_off\">${bars[n]}</span>"
        fi
    done
    printf ' <span font_family="JetBrains Mono">%s</span>' "$out"
}

wifi_signal() {
    local active signal _ssid
    # Terse output escapes ":" in the network name; SSID is the last field on purpose.
    while IFS=: read -r active signal _ssid; do
        if [[ $active == yes ]]; then
            printf '%s' "$signal"
            return
        fi
    done < <(nmcli -t -f ACTIVE,SIGNAL,SSID device wifi list --rescan no)
    printf '0'
}

# A cable: the RJ45 mark and the interface, which stays short, instead of the name of the
# connection ("Wired connection 1"), which goes to the tooltip. genmon puts the mark and
# the text in buttons of their own, so their inner sides lose the usual padding.
wired() {
    local device=$1 connection=$2
    local css='button { margin: 14px 0; border-radius: 3px; padding: 0 8px 0 0; min-width: 0; } button:first-child { padding: 0 0 0 8px; } image { margin: 0; padding: 0; } button:hover { background-color: #1a202b; }'
    printf '<icon>%s</icon><iconclick>h3xd-network</iconclick>' "$wired_icon"
    printf '<txt><span foreground="%s">%s</span></txt>' "$value" "$(escape "$device")"
    printf '<tool>%s</tool><txtclick>h3xd-network</txtclick><css>%s</css>\n' \
        "$(escape "Wired: $connection on $device")" "$css"
}

network() {
    local type state device connection cable='' cable_connection='' other='' signal
    # Wi-Fi comes first: its signal is what changes on a laptop. The connection is the last
    # field, since terse output only escapes the ":" inside it.
    while IFS=: read -r type state device connection; do
        [[ $state == connected ]] || continue
        if [[ $type == wifi ]]; then
            signal=$(wifi_signal)
            field wifi "$connection" h3xd-network "Wi-Fi $connection, signal $signal %" \
                "$(signal_bars "$signal")"
            return
        fi
        if [[ $type == ethernet && -z $cable ]]; then
            cable=$device cable_connection=$connection
        fi
        [[ -n $other ]] || other=$connection
    done < <(nmcli -t -f TYPE,STATE,DEVICE,CONNECTION device)
    if [[ -n $cable ]]; then
        wired "$cable" "$cable_connection"
    elif [[ -n $other ]]; then
        field net "$other" h3xd-network "Connected: $other"
    else
        field net offline h3xd-network "Not connected; click to choose a Wi-Fi network"
    fi
}

volume() {
    local reading level
    reading=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    if [[ $reading == *MUTED* ]]; then
        field vol muted h3xd-volume "Sound muted; click for H3XD Volume"
        return
    fi
    level=$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$reading")
    field vol "$level" h3xd-volume "Volume $level %; click for H3XD Volume"
}

battery() {
    local supply
    for supply in /sys/class/power_supply/BAT*; do
        if [[ -r $supply/capacity ]]; then
            field bat "$(<"$supply/capacity")%" xfce4-power-manager-settings \
                "Battery $(<"$supply/capacity") %, $(<"$supply/status")"
            return
        fi
    done
    echo '<txt></txt><tool></tool>'
}

case ${1:-} in
    title) title ;;
    clock) clock ;;
    network) network ;;
    volume) volume ;;
    battery) battery ;;
    *) echo "usage: h3xd-panel-status title|clock|network|volume|battery" >&2; exit 2 ;;
esac
