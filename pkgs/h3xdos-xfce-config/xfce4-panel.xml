<?xml version="1.0" encoding="UTF-8"?>

<!-- Design 2a: mark menu, workspaces, active window title, centred clock, text indicators,
     tray and user, floating on the wallpaper: the panel is 60 px high with a transparent
     background (the compositor of xfwm4 blends it), so items keep 10 px from the top and
     windows start 10 px below. Plugin ids are referenced by the h3xd-dark CSS. -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="24"/>
      <property name="size" type="uint" value="60"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.000000"/>
        <value type="double" value="0.000000"/>
        <value type="double" value="0.000000"/>
        <value type="double" value="0.000000"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="h3xd-mark"/>
      <property name="show-button-title" type="bool" value="false"/>
    </property>
    <property name="plugin-2" type="string" value="pager">
      <property name="miniature-view" type="bool" value="false"/>
      <property name="rows" type="uint" value="1"/>
    </property>
    <property name="plugin-3" type="string" value="genmon">
      <property name="command" type="string" value="/usr/lib/h3xd/panel-status title"/>
      <property name="update-period" type="int" value="1000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-5" type="string" value="genmon">
      <property name="command" type="string" value="/usr/lib/h3xd/panel-status clock"/>
      <property name="update-period" type="int" value="2000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <property name="plugin-6" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-7" type="string" value="genmon">
      <property name="command" type="string" value="/usr/lib/h3xd/panel-status network"/>
      <property name="update-period" type="int" value="5000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <property name="plugin-8" type="string" value="genmon">
      <property name="command" type="string" value="/usr/lib/h3xd/panel-status volume"/>
      <property name="update-period" type="int" value="2000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <property name="plugin-9" type="string" value="genmon">
      <property name="command" type="string" value="/usr/lib/h3xd/panel-status battery"/>
      <property name="update-period" type="int" value="30000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <!-- One row keeps tray icons inside the 40 px bar of the 60 px panel; left click opens
         the menu, since apps such as Discord do nothing on a plain activate. -->
    <property name="plugin-10" type="string" value="systray">
      <property name="square-icons" type="bool" value="false"/>
      <property name="single-row" type="bool" value="true"/>
      <property name="menu-is-primary" type="bool" value="true"/>
    </property>
    <property name="plugin-11" type="string" value="actions"/>
  </property>
</channel>
