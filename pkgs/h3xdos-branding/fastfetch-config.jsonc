{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Colors are ANSI slots of the H3XD terminal palette: 34/94 blue, 91 red, 90 muted.
    // The mark as in the design: light halves, the blue bar across the gap.
    "logo": {
        "type": "file",
        "source": "/usr/share/h3xdos/logo.txt",
        "color": {
            "1": "97",
            "2": "34"
        },
        "padding": {
            "left": 1,
            "right": 4
        }
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 10
        },
        "color": {
            "keys": "94"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "94",
                "at": "90",
                "host": "91"
            }
        },
        "break",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "custom",
            "key": "Base",
            "format": "Arch, rolling"
        },
        {
            "type": "de",
            "key": "Desktop"
        },
        {
            "type": "theme",
            "key": "Theme"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        "break",
        // The 16 palette colours as two rows of wide blocks, as in sheet 2f.
        {
            "type": "colors",
            "symbol": "block",
            "block": {
                "width": 5
            }
        }
    ]
}
