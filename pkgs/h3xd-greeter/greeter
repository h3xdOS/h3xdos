#!/usr/bin/env python3
"""H3XD login and lock screen (design 2c), a LightDM greeter.

LightDM runs it for the login screen and, through light-locker, for the lock screen.
The password goes to LightDM, which checks it with PAM; the greeter never sees a session.
If the greeter cannot set itself up, it hands over to lightdm-gtk-greeter, so that a
broken update cannot lock anybody out."""

import os
import sys

FALLBACK = "lightdm-gtk-greeter"


def fall_back(error):
    print(f"h3xd-greeter: {error!r}; starting {FALLBACK}", file=sys.stderr)
    os.execvp(FALLBACK, [FALLBACK])


try:
    import gi

    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("LightDM", "1")
    gi.require_version("PangoCairo", "1.0")
    gi.require_version("Rsvg", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, LightDM, PangoCairo, Rsvg
except (ImportError, ValueError) as error:
    fall_back(error)

