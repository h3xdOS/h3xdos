PADDING_TOP_SHARE = 72 / 900
PADDING_LEFT = 80
ENTRY_WIDTH = 340
AVATAR_WIDTH = 34
AVATAR_HEIGHT = 40
AVATAR_FILL = (0x2b / 255, 0x32 / 255, 0x40 / 255)
AVATAR_INK = (0xe6 / 255, 0xed / 255, 0xf3 / 255)
BACKGROUND = "#0f1218"
# Sessions a person should not pick at the login screen.
HIDDEN_SESSIONS = {"h3xdos-installer"}

