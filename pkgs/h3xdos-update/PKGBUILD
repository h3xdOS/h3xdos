# Maintainer: h3xdOS <https://github.com/h3xdOS>

pkgname=h3xdos-update
pkgver=2026.10.24
pkgrel=1
pkgdesc='H3XD updater: pacman, drivers, default apps, the Ubuntu and Kali containers, GitHub releases'
arch=('any')
url='https://github.com/h3xdOS/h3xdos'
license=('GPL-3.0-or-later')
depends=('bash'
         'curl'
         'distrobox'
         'fakeroot'
         'h3xdos-hardware'
         'jq'
         'libnotify'
         'pacman-contrib'
         'podman'
         'sudo'
         'xfce4-terminal')
backup=('etc/h3xdos/update.conf')
install=h3xdos-update.install
# Sources are files tracked next to this PKGBUILD in git.
source=('h3xdos-update'
        'update.conf'
        'h3xdos-update.desktop'
        'h3xdos-update-check.service'
        'h3xdos-update-check.timer')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 h3xdos-update "$pkgdir/usr/bin/h3xdos-update"
  install -Dm644 update.conf "$pkgdir/etc/h3xdos/update.conf"
  install -Dm644 h3xdos-update.desktop "$pkgdir/usr/share/applications/h3xdos-update.desktop"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" h3xdos-update-check.service h3xdos-update-check.timer
}
