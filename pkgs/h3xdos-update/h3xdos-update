#!/usr/bin/env bash
# Updates H3XD: Arch Linux and [h3xdos] packages through pacman (the [h3xdos]
# repo is served from GitHub Pages), drivers for the detected hardware, the default
# applications, the Ubuntu and Kali distrobox containers and the Flatpak applications,
# and reports the newest H3XD release published on GitHub.
set -euo pipefail

readonly release_api=https://api.github.com/repos/h3xdOS/h3xdos/releases/latest
readonly releases_page=https://github.com/h3xdOS/h3xdos/releases
readonly config_file=/etc/h3xdos/update.conf
readonly default_apps=h3xdos-apps
readonly boxes=(ubuntu kali)
readonly network_timeout_s=15
readonly updates_available=10
# Xfce reads the theme of these at login and their xfconf defaults when xfconfd starts,
# which outlives a quick log out and back in; a restart loads both.
readonly session_packages='^(h3xd-greeter|h3xd-icons|h3xd-shell|h3xd-theme|h3xdos-branding|h3xdos-xfce-config)$'

usage() {
    echo "usage: h3xdos-update [--check | --notify]" >&2
    exit 2
}

# checkupdates exits 2 when nothing is pending and 1 when it cannot sync.
pending_packages() {
    checkupdates || [[ $? == 2 ]]
}

# grep -c prints 0 and exits 1 when nothing matches.
count_lines() {
    grep -c . <<<"$1" || [[ $? == 1 ]]
}

latest_release() {
    curl -fsS --max-time "$network_timeout_s" "$release_api" | jq -r '.tag_name'
}

# A step runs unless the config file sets it to no.
enabled() {
    [[ -r $config_file ]] || return 0
    [[ $(awk -F= -v key="$1" '$1 == key { value = $2 } END { print value }' "$config_file") != no ]]
}

session_versions() {
    pacman -Q | awk -v re="$session_packages" '$1 ~ re'
}

existing_boxes() {
    local box
    for box in "${boxes[@]}"; do
        if podman container exists "$box"; then
            echo "$box"
        fi
    done
}

case ${1:-} in
    --check)
        pending=$(pending_packages)
        count=$(count_lines "$pending")
        echo "Package updates: $count"
        if (( count > 0 )); then
            printf '%s\n' "$pending"
            exit "$updates_available"
        fi
        ;;
    --notify)
        count=$(count_lines "$(pending_packages)")
        if (( count > 0 )); then
            notify-send --app-name="System Update" --icon=h3xd \
                "H3XD updates" "$count package updates are ready. Open System Update from the menu."
        fi
        ;;
    "")
        echo "== Arch Linux and H3XD packages"
        session_before=$(session_versions)
        sudo pacman -Syu
        if enabled install_drivers; then
            echo "== Drivers"
            sudo h3xdos-drivers --install
        fi
        # pacman -T prints what is missing; once installed, the user may remove single apps.
        if enabled install_default_apps && ! pacman -T -- "$default_apps" >/dev/null; then
            echo "== H3XD applications"
            sudo pacman -S --needed -- "$default_apps"
        fi
        mapfile -t present < <(existing_boxes)
        for box in "${present[@]}"; do
            echo "== $box container"
            distrobox upgrade "$box"
        done
        if enabled update_flatpaks && command -v flatpak >/dev/null; then
            echo "== Flatpak applications"
            # Updating system-wide apps needs no password (flatpak's polkit policy).
            flatpak update --system --noninteractive
            flatpak uninstall --system --unused --noninteractive
        fi
        echo "== H3XD releases"
        if tag=$(latest_release); then
            echo "Newest release: $tag ($releases_page)"
        else
            echo "No release information from GitHub; see $releases_page" >&2
        fi
        # pacman removes the module tree of the running kernel when it upgrades linux.
        if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
            echo "The kernel was updated: restart the computer to use it."
        elif [[ $(session_versions) != "$session_before" ]]; then
            echo "The H3XD desktop was updated: restart the computer to load it."
        fi
        ;;
    *)
        usage
        ;;
esac
