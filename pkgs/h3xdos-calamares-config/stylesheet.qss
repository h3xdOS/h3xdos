/* H3XD installer, sheet 2f of "h3xdOS v2": flat, 4 px corners, depth by tone,
   focus is a 2 px accent border. surface #181c25, sidebar #151922, field #10141b,
   line #2b3240, text #e6edf3 / #c6cbd5 / #8b95a5, accent #1793d1, on-accent #0f1320. */

QWidget {
    background-color: #181c25;
    color: #e6edf3;
    font-family: "IBM Plex Sans";
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
}

QPushButton {
    background-color: #2b3240;
    border: 2px solid #2b3240;
    border-radius: 3px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #3a4253;
    border-color: #3a4253;
}

QPushButton:focus {
    border-color: #1793d1;
}

QPushButton:default {
    background-color: #1793d1;
    border-color: #1793d1;
    color: #0f1320;
    font-weight: 600;
}

QPushButton:disabled {
    background-color: #1f2430;
    border-color: #1f2430;
    color: #8b95a5;
}

QLineEdit, QComboBox, QSpinBox, QListView, QTreeView, QTableView, QTextBrowser, QPlainTextEdit {
    background-color: #10141b;
    border: 2px solid #10141b;
    border-radius: 3px;
    color: #e6edf3;
    selection-background-color: #14405e;
    selection-color: #e6edf3;
}

QLineEdit:focus, QComboBox:focus, QListView:focus, QTreeView:focus {
    border-color: #1793d1;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #12304a;
    color: #e6edf3;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #10141b;
    border: 2px solid #3a4253;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked {
    background-color: #1793d1;
    border-color: #1793d1;
}

QRadioButton::indicator:checked {
    border: 5px solid #1793d1;
}

QProgressBar {
    background-color: #2b3240;
    border: none;
    border-radius: 2px;
    color: transparent;
    max-height: 4px;
}

QProgressBar::chunk {
    background-color: #1793d1;
    border-radius: 2px;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #3a4253;
    border-radius: 4px;
}

#sidebarApp {
    background-color: #151922;
}
