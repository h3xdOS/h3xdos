---
componentName: h3xdos

welcomeStyleCalamares: false
welcomeExpandingLogo: true
# The live medium runs only the installer, so it takes the whole screen.
windowExpanding: fullscreen
windowSize: 1000px,660px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
  productName: "H3XD"
  shortProductName: "H3XD"
  version: "rolling"
  shortVersion: "rolling"
  versionedName: "H3XD Operating System"
  shortVersionedName: "H3XD"
  bootloaderEntryName: "H3XD"
  productUrl: "https://github.com/h3xdOS/h3xdos"
  supportUrl: "https://github.com/h3xdOS/h3xdos/issues"
  knownIssuesUrl: "https://github.com/h3xdOS/h3xdos/issues"
  releaseNotesUrl: "https://github.com/h3xdOS/h3xdos/releases"

images:
  productIcon: "/usr/share/pixmaps/h3xd.svg"
  productLogo: "/usr/share/h3xd/h3xd-mark.svg"
  productWelcome: "/usr/share/h3xd/h3xd-lockup.svg"

# Sheet 2f tokens; the current step is the only accent fill in the sidebar.
style:
  SidebarBackground: "#151922"
  SidebarText: "#c6cbd5"
  SidebarTextCurrent: "#0f1320"
  SidebarBackgroundCurrent: "#1793d1"

slideshow: "show.qml"
slideshowAPI: 2

# Installer logs never leave the machine.
uploadServer:
  type: "none"
