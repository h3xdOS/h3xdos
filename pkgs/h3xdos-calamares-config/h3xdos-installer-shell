#!/usr/bin/python3
"""Live-medium shell around the H3XD installer.

Draws the H3XD background behind Calamares and, once Calamares exits, offers to
start it again, open the network settings, restart or power off. The live medium
exists to install H3XD, so there is no desktop to fall back to.
"""

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gio, Gtk  # noqa: E402

INSTALLER = ["sudo", "-E", "calamares"]
NETWORK_SETTINGS = ["nm-connection-editor"]
RESTART = ["systemctl", "reboot"]
POWER_OFF = ["systemctl", "poweroff"]
WALLPAPER = "/usr/share/backgrounds/h3xd/h3xd-dark.png"
LOGO = "/usr/share/h3xd/h3xd-lockup.svg"
LOGO_WIDTH = 360

# Sheet 2f of the H3XD design: secondary buttons on line tone, focus as a 2 px accent border.
STYLE = b"""
label { color: #c6cbd5; font-family: "IBM Plex Sans"; font-size: 15pt; }
button { background: #2b3240; color: #e6edf3; border: 2px solid #2b3240;
         border-radius: 3px; padding: 8px 18px; box-shadow: none; text-shadow: none;
         font-family: "IBM Plex Sans"; }
button:hover { background: #3a4253; border-color: #3a4253; }
button:focus { border-color: #1793d1; }
"""


class InstallerShell(Gtk.Window):
    def __init__(self):
        super().__init__(title="h3xdOS")
        # A desktop-type window stays below Calamares and its dialogs.
        self.set_type_hint(Gdk.WindowTypeHint.DESKTOP)
        self.set_decorated(False)

        self.background = Gtk.Image()
        self.status = Gtk.Label()
        self.actions = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        for label, handler in (
            ("Start the installer again", lambda _: self.start_installer()),
            ("Network settings", lambda _: Gio.Subprocess.new(NETWORK_SETTINGS, Gio.SubprocessFlags.NONE)),
            ("Restart", lambda _: Gio.Subprocess.new(RESTART, Gio.SubprocessFlags.NONE)),
            ("Power off", lambda _: Gio.Subprocess.new(POWER_OFF, Gio.SubprocessFlags.NONE)),
        ):
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            self.actions.pack_start(button, False, False, 0)

        logo = Gtk.Image.new_from_pixbuf(
            GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, LOGO_WIDTH, -1, True))
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24,
                         halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        column.pack_start(logo, False, False, 0)
        column.pack_start(self.status, False, False, 0)
        column.pack_start(self.actions, False, False, 0)

        overlay = Gtk.Overlay()
        overlay.add(self.background)
        overlay.add_overlay(column)
        self.add(overlay)

        self.get_screen().connect("size-changed", lambda _: self.fit_screen())
        self.fit_screen()

    def fit_screen(self):
        screen = self.get_screen()
        width, height = screen.get_width(), screen.get_height()
        self.move(0, 0)
        self.resize(width, height)
        self.background.set_from_pixbuf(
            GdkPixbuf.Pixbuf.new_from_file_at_scale(WALLPAPER, width, height, False))

    def start_installer(self):
        self.status.set_text("Starting the H3XD installer")
        self.actions.hide()
        installer = Gio.Subprocess.new(INSTALLER, Gio.SubprocessFlags.NONE)
        installer.wait_async(None, self.on_installer_exit)

    def on_installer_exit(self, installer, result):
        installer.wait_finish(result)
        self.status.set_text("The installer has closed")
        self.actions.show_all()


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(STYLE)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    shell = InstallerShell()
    shell.connect("destroy", Gtk.main_quit)
    shell.show_all()
    shell.start_installer()
    Gtk.main()


if __name__ == "__main__":
    main()
