<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>H3XD</vendor>
  <vendor_url>https://github.com/h3xdOS/h3xdos</vendor_url>
  <action id="org.h3xd.store.manage">
    <description>Install and remove applications</description>
    <message>H3XD Apps needs your password to install or remove applications.</message>
    <icon_name>package-x-generic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/h3xd/store-helper</annotate>
  </action>
</policyconfig>
