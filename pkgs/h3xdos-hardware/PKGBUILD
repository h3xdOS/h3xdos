# Maintainer: h3xdOS <https://github.com/h3xdOS>

pkgname=h3xdos-hardware
pkgver=2026.10.23
pkgrel=2
pkgdesc='H3XD hardware support: driver detection, zram swap and SSD TRIM'
arch=('any')
url='https://github.com/h3xdOS/h3xdos'
license=('GPL-3.0-or-later')
depends=('bash'
         'mkinitcpio'
         'pacman'
         'pciutils'
         'systemd'
         'util-linux'
         'zram-generator')
install=h3xdos-hardware.install
# Sources are files tracked next to this PKGBUILD in git.
source=('h3xdos-drivers'
        'zram-generator.conf'
        'sysctl-zram.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 h3xdos-drivers "$pkgdir/usr/bin/h3xdos-drivers"
  install -Dm644 zram-generator.conf "$pkgdir/usr/lib/systemd/zram-generator.conf.d/50-h3xdos.conf"
  install -Dm644 sysctl-zram.conf "$pkgdir/usr/lib/sysctl.d/90-h3xdos-zram.conf"
}
