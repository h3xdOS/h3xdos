[Icon Theme]
Name=H3XD
Comment=Flat icons for H3XD (Xfce 4.20)
Inherits=Papirus-Dark,hicolor
Directories=scalable/apps,scalable/devices,scalable/places,scalable/mimetypes,scalable/status,scalable/actions,scalable/panel

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/devices]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/status]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Status

[scalable/actions]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions

[scalable/panel]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Status
